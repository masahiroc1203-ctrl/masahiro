# ---- LS720D への接続設定 (このファイルを .env という名前でコピーして書き換える) ----

# LS720D の IP アドレス (NAS Navigator2 で確認できます)
NAS_IP=192.168.1.50

# 保存先: 「共有フォルダ名/その中のフォルダ名」
# ※ フォルダは事前に PC などから作っておいてください
NAS_SHARE=share/SmartphoneBackup

# LS720D のユーザー名とパスワード (アクセス制限をしていない共有フォルダなら空のままで可)
# ※ パスワードに「,」(カンマ) は使えません
NAS_USER=
NAS_PASSWORD=

# 接続できないとき (mount error(95) など) は 2.1 や 2.0 にしてみてください
NAS_SMB_VERSION=3.0

# ---- アプリの設定 ----

# date = 撮影年月ごとにフォルダ分け / flat = 分けない
BACKUP_LAYOUT=date

# 設定するとスマホで開いたときにパスワードを聞かれます (空ならなし)
BACKUP_PASSWORD=
